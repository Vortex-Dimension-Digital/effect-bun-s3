{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc", "import"],
	"categories": {
		"correctness": "error",
		"suspicious": "error"
	},
	"options": {
		"typeAware": true,
		"denyWarnings": true
	},
	"rules": {
		"eslint/no-underscore-dangle": [
			"error",
			{
				"allow": ["_tag"]
			}
		]
	}
}
